<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the client-side code the mobile app depends on.

    This project targets plain net10.0 rather than a platform head, so it runs on
    any machine and in CI without an emulator. It references FleetGo.Shared - the
    platform-independent half of the mobile stack, where the typed API client and
    serialisation live - and, since Phase 2, FleetGo.Mobile.Core, which holds
    LoginViewModel and the session/authentication logic (see that project's own
    comments, and docs/architecture.md's "Known gap: view model tests", for why).

    Test runner: Microsoft.Testing.Platform, same as FleetGo.API.Tests.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are executables: they self-host their runner. -->
    <OutputType>Exe</OutputType>
    <!-- Run through Microsoft.Testing.Platform instead of VSTest. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FleetGo.Shared\FleetGo.Shared.csproj" />
    <ProjectReference Include="..\..\src\FleetGo.Mobile.Core\FleetGo.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

