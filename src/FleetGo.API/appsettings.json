{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FleetGo",
    "Audience": "FleetGo.Mobile",
    "AccessTokenLifetimeMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 30
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 5,
    "MaxVerificationAttempts": 5,
    "ResendCooldownSeconds": 30,
    "RequestRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "VerifyRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}

