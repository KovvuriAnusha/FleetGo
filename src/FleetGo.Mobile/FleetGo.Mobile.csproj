<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FleetGo.Mobile - the .NET MAUI driver app.

    One project, three platform heads (SingleProject). Platform-specific code
    lives under Platforms/ and is compiled only into the head it belongs to.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <!-- To build the Windows head, add on a Windows machine:
         <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
         and a Platforms/Windows folder. -->

    <OutputType>Exe</OutputType>
    <RootNamespace>FleetGo.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Compile XAML bindings instead of resolving them by reflection at runtime:
         faster, trimming-safe, and binding typos become build errors. Requires
         x:DataType on every binding scope. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!-- Display name and identity -->
    <ApplicationTitle>FleetGo</ApplicationTitle>
    <ApplicationId>com.fleetgo.mobile</ApplicationId>

    <!-- Versions: DisplayVersion is what users see, ApplicationVersion is the
         monotonically increasing build number the stores require. -->
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: the foreground SVG is composited over the Color background. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B63E5" />

    <!-- Splash screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B63E5" BaseSize="128,128" />

    <!-- Images, fonts and raw assets -->
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- MVVM source generators: ObservableObject, [ObservableProperty], [RelayCommand]. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- IHttpClientFactory: pooled handlers, per-client configuration, and the
         seam where retry/resilience policies are added in a later phase. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- SMS Retriever API - Android's permission-free OTP autofill mechanism (see
         Platforms/Android/AndroidOtpAutofillListener.cs). Deliberately NOT SmsRetriever's
         sibling "SMS User Consent API" package, which shows the user a system dialog
         before releasing the message - the Retriever API autofills silently, which is
         the behaviour Phase 3 asks for.
         Version pinned to the exact release published for net10.0-android36.0 (confirmed
         on nuget.org - the originally-written "118.1.0.1" does not exist as a real
         version, which is what produced NU1603 against a real Mac restore). Binds
         com.google.android.gms:play-services-auth 21.6.0 - SmsRetriever's API surface
         (SmsRetrievedAction/ExtraStatus/ExtraSmsMessage/GetClient/StartSmsRetriever) is
         unchanged from the version this was originally written against, so no source
         changes were needed in the two files that use it. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="121.6.0.1" />
    <!-- AndroidX Biometric - Google's recommended replacement for the deprecated
         FingerprintManager, covering fingerprint and face unlock alike through one API
         (see Platforms/Android/AndroidBiometricAuthenticator.cs).
         Version pinned to the exact, current release published for net10.0-android36.0
         (confirmed on nuget.org - "1.2.0.5" does not exist; this binding has never gone
         past androidx.biometric 1.1.0 upstream, which 1.1.0.33 still binds unchanged, so
         AndroidBiometricAuthenticator.cs's BiometricManager/BiometricPrompt usage needed
         no changes either). -->
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetGo.Shared\FleetGo.Shared.csproj" />
    <ProjectReference Include="..\FleetGo.Mobile.Core\FleetGo.Mobile.Core.csproj" />
  </ItemGroup>

</Project>

