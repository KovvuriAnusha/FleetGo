<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Lets the simulator/desktop app reach a locally hosted development API over
	     plain HTTP. NSAllowsLocalNetworking is scoped to local addresses only, so
	     App Transport Security still applies to every real host. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Required by LocalAuthentication before it may use Face ID (Touch ID needs
	     no usage-description key). Shown once, the first time AppleBiometricAuthenticator
	     evaluates a Face ID policy - without this key iOS/Mac Catalyst terminates the
	     app outright rather than merely failing the call. -->
	<key>NSFaceIDUsageDescription</key>
	<string>FleetGo uses Face ID to let you unlock your existing signed-in session without re-entering your password.</string>
</dict>
</plist>
