<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    allowBackup="false": the signed-in session (access and refresh tokens) lives in
    SecureStorage, which on Android is EncryptedSharedPreferences. Leaving backup on would
    let those preferences travel into a cloud or adb backup and be restored onto another
    device - and, because the encryption keys are held in the device keystore and do NOT
    travel with them, a restored copy also tends to come back unreadable, which surfaces as
    SecureStorage throwing on launch. Both problems disappear by not backing this app up;
    there is nothing in it worth restoring that signing in again does not rebuild.
  -->
  <application android:allowBackup="false"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true"
               android:networkSecurityConfig="@xml/network_security_config" />

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Required by IConnectivity to report whether the device has a usable network. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Biometric unlock (AndroidX Biometric). A "normal" permission the system grants
       automatically at install time - never a runtime prompt, and it does not by itself
       let the app read any biometric data (see AndroidBiometricAuthenticator.cs). -->
  <uses-permission android:name="android.permission.USE_BIOMETRIC" />
  <!-- SMS Retriever API OTP autofill (AndroidOtpAutofillListener.cs). Deliberately NOT
       READ_SMS or RECEIVE_SMS - the whole point of this API is that it needs neither. -->

</manifest>
