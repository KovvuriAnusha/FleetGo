<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FleetGo.Mobile.Core.ViewModels;assembly=FleetGo.Mobile.Core"
             xmlns:fleet="clr-namespace:FleetGo.Shared.Contracts.Fleet;assembly=FleetGo.Shared"
             x:Class="FleetGo.Mobile.Views.RouteDetailPage"
             x:DataType="viewmodels:RouteDetailViewModel"
             Title="Route">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12" RowSpacing="8">

        <!-- Loading -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" />

        <!-- Error, with retry -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasErrorMessage}"
                Padding="16"
                StrokeThickness="1"
                Stroke="{StaticResource Danger}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding ErrorMessage}" LineBreakMode="WordWrap" />
                <Button Text="Try again" Command="{Binding ReloadCommand}" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Border>

        <!-- Route summary -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasRoute}"
                Padding="16"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding Route.RouteNumber}" Style="{StaticResource Headline}" />
                    <Label Grid.Column="1" Text="{Binding Route.Status}" VerticalOptions="Center" TextColor="{StaticResource Primary}" />
                </Grid>

                <Label Text="{Binding Route.RouteDate, StringFormat='{}{0:dddd d MMMM yyyy}'}"
                       TextColor="{StaticResource Gray500}" />

                <Label Text="{Binding Route.StopCount, StringFormat='{}{0} stops on this route'}"
                       TextColor="{StaticResource Gray500}" />

                <!-- Vehicle: registration always travels on the route; make/model needs the
                     vehicle record, which may not have loaded. -->
                <Label Text="{Binding Route.VehicleRegistrationNumber, StringFormat='Vehicle {0}'}"
                       IsVisible="{Binding HasVehicleRegistration}"
                       FontAttributes="Bold"
                       Margin="0,6,0,0" />

                <Label IsVisible="{Binding HasVehicle}"
                       TextColor="{StaticResource Gray500}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Vehicle.Make}" />
                            <Span Text=" " />
                            <Span Text="{Binding Vehicle.Model}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Border>

        <!-- Stops -->
        <Grid Grid.Row="3">

            <VerticalStackLayout IsVisible="{Binding HasNoStops}"
                                 Spacing="6"
                                 Padding="8,24"
                                 VerticalOptions="Start">
                <Label Text="No stops yet" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="This route has no stops on it."
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Stops}"
                                SelectionMode="Single"
                                SelectionChanged="OnStopSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="fleet:StopResponse">
                            <Border Padding="14"
                                    Margin="0,4"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding Sequence}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           WidthRequest="24"
                                           HorizontalTextAlignment="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding CustomerName}" FontAttributes="Bold" />
                                        <Label Text="{Binding PackageCount, StringFormat='{}{0} packages'}"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding Status}"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
